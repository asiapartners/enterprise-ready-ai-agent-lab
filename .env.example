# =============================================================================
# .env.example — Local development template for openclaw-agent365
#
# Copy to .env and fill in real values. NEVER commit .env to source control.
# Production secrets must be sourced from Azure Key Vault (KEY_VAULT_URI).
# =============================================================================

# ─── Runtime ─────────────────────────────────────────────────────────────────
APP_ENV=development
PORT=3978
LOG_LEVEL=info

# ─── OpenClaw runtime ────────────────────────────────────────────────────────
# Resolution order: in-process SDK ('openclaw' npm package) → HTTP gateway → stub
OPENCLAW_MODEL=anthropic/claude-opus-4-6
OPENCLAW_FALLBACK_MODELS=openai/gpt-4o,anthropic/claude-3-5-sonnet
OPENCLAW_CONFIG_PATH=./config
OPENCLAW_PLUGIN_DIR=./plugins
# Optional explicit gateway override (otherwise resolved from
# config/openclaw-config.json gateway.host:port)
# OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789

# ─── Microsoft Agent 365 — App Registration ──────────────────────────────────
A365_APP_ID=
A365_APP_PASSWORD=
A365_TENANT_ID=
MICROSOFT_APP_TYPE=SingleTenant

# ─── Federated Identity Credentials (Agentic Identity) ───────────────────────
AA_INSTANCE_ID=
AGENT_IDENTITY=agent@your-tenant.onmicrosoft.com

# ─── Owner ───────────────────────────────────────────────────────────────────
OWNER=owner@your-tenant.onmicrosoft.com
OWNER_AAD_ID=

# ─── LLM provider keys (at least one required) ───────────────────────────────
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-aoai.openai.azure.com

# ─── Business hours & DM policy ──────────────────────────────────────────────
BUSINESS_HOURS_START=08:00
BUSINESS_HOURS_END=18:00
TIMEZONE=America/Los_Angeles
DM_POLICY=pairing

# ─── Network policy (requires NET_ADMIN capability when enabled) ─────────────
NETWORK_MODE=unrestricted
# NETWORK_ALLOWLIST=api.example.com,internal.contoso.com

# ─── Observability ───────────────────────────────────────────────────────────
# APPINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...
OTEL_SERVICE_NAME=openclaw-agent365
OTEL_SERVICE_VERSION=0.1.0

# ─── Azure Key Vault (production) ────────────────────────────────────────────
# KEY_VAULT_URI=https://your-kv.vault.azure.net/
